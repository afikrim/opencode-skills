[0m⚙ [0mexecute {"code":"const res = await tools.second_brain.create_note({\n  segment: \"work\",\n  project: \"inline-design\",\n  title: \"Browser previews of 4-band GeoTIFF must drop band 4 (JPEG reads back as CMYK)\",\n  tags: \"gdal,geotiff,jpeg,preview,browser,inline-design\",\n  memory_type: \"learning\",\n  links: \"[[01-Work/inline-design/202610282151-basemap-extraction-defaults-to-jpeg-ycbcr-tiled-geotiff-not-]]\",\n  body: `Rendering a 4-band GeoTIFF to JPEG for browser viewing produces inverted/odd colors: GDAL warns a 4-band JPEG is read back as CMYK.\nThe ECW source does not label whether band 4 is alpha or NIR, so the safe browser preview uses bands 1-2-3 (RGB) only.\nTo inspect band 4 deliberately, render it as a separate grayscale preview instead of blending it into RGB.\nLarge ECW/GeoTIFF previews should be downsampled from internal overviews (gdal_translate -outsize), which stays fast on gigapixel files — a 1.43 GB GeoTIFF rendered to ~2,370 x 2,270 JPEG quickly.\nBrowser previews are a one-off render today; the natural product form is GET /api/v1/extractions/{id}/preview?w=2400 downsampling on the fly from overviews.`,\n  entities: [\n    {name:\"inline-design\", type:\"Project\"},\n    {name:\"GDAL\", type:\"Technology\"},\n    {name:\"GeoTIFF\", type:\"Topic\"},\n    {name:\"ECW\", type:\"Topic\"}\n  ],\n  relations: [\n    {source:\"inline-design\", type:\"USES\", target:\"GDAL\", quote:\"GDAL warns a 4-band JPEG is read back as CMYK\"},\n    {source:\"GDAL\", type:\"PROVIDES\", target:\"GeoTIFF\", quote:\"render a 4-band GeoTIFF to JPEG\"}\n  ]\n});\nconsole.log(JSON.stringify(res).slice(0,600));"} 
