  relations: [\n      { source: \"Hermes\", type: \"USES\", target: \"OpenCode\" },\n      { source: \"Aziz\", type: \"WORKS_ON\", target: \"Kanban\" }\n    ]\n  }\n});\nreturn r;"} 
