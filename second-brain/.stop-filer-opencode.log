   { name: \"Postgres\", type: \"Technology\" },\n  ],\n  relations: [\n    { source: \"Seatap\", type: \"USES\", target: \"stp-api\" },\n    { source: \"stp-api\", type: \"USES\", target: \"SHA-256\" },\n    { source: \"stp-api\", type: \"STORES\", target: \"Postgres\" },\n  ],\n});\nreturn r;"} 
