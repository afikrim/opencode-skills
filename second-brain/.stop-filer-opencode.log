# seatap-compose.service — per-user systemd bootstrap for the Seatap stack.
#
# RUNBOOK (run on the server as the service user):
#   1. install -m 644 seatap-compose.service ~/.config/systemd/user/seatap-compose.service
#   2. systemctl --user daemon-reload
#   3. systemctl --user enable --now seatap-compose.service
# Prerequisites: user lingering enabled, user in the docker group, and the
# system docker.socket unit enabled. There is no user-level docker.socket,
# so this unit declares no socket dependency: the Docker CLI socket-activates
# the system socket once ready, and Restart=on-failure retries early-boot
# ordering. The existing per-user cloudflared unit is separate and untouched.
# Stopping this unit never removes volumes. Paths use %h only.
[Unit]
Description=Seatap Compose stack via seatapctl up

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 %h/seatap/current/api/deploy/seatapctl.py up --env %h/seatap/private/production.env
Restart=on-failure
RestartSec=15s
TimeoutStartSec=600

[Install]
WantedBy=default.target
---
#!/usr/bin/env python3
"""Single-file Compose operator helper (M5d, Python stdlib only).

Lives at RELEASE/api/deploy/seatapctl.py; the release root (three levels up)
holds release.json. Always drives the same production Compose file under the
explicit project seatap-production (--project only for isolated synthetic
rehearsal). No overlays, no host ports, no volume deletion, no whole-host,
DNS, or tunnel operations. Private values come from --env-file only and are
never logged; docker failures are reported generically so raw stderr that may
carry secrets is never printed.
"""

import argparse
import json
import os
import re
import stat
import subprocess
import sys
import time

PROJECT_DEFAULT = "seatap-production"
COMMANDS = ("build", "up-private", "up", "status", "logs", "stop", "restart")
SAFE_LOG_SERVICES = ("api", "web", "migrate")
REVISION_LABEL = "org.opencontainers.image.revision"
PLATFORM = "linux/amd64"
WANT_ARCH = "amd64"
SHA_RE = re.compile(r"^[0-9a-f]{40}$")


def fail(message):
    raise SystemExit("seatapctl: %s" % message)


def default_root():
    return os.path.dirname(
        os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
