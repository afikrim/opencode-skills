[0m⚙ [0mexecute {"code":"const a = await tools.second_brain.create_note({\n  segment: \"personal\",\n  area: \"OpenCode\",\n  title: \"OpenCode server emits `session.execution.started`/`succeeded` — the TTS plugin must hook those, not only `session.idle`\",\n  body: \"Verified while building opencode-speak on OpenCode 2.2.2: the server emits `session.execution.started` and `session.execution.succeeded`, the same event names the TUI part receives.\\nAn earlier design that hooked only `session.idle` missed turns; the PRD was corrected.\\nLesson: don't guess plugin event names — log what the server actually emits during a run and match on that.\\nThis supersedes the `session.idle`-only trigger in [[202611011203-opencode-tts-plugin-server-side-speak-on-idle-tui-only-toggl]]; the rest of that design (server-side speech, TUI-only toggle, macOS `say`) still stands.\",\n  tags: \"opencode, plugin, events, tts, bugfix\",\n  memory_type: \"learning\",\n  entities: [{name:\"OpenCode\", type:\"System\"}, {name:\"opencode-speak\", type:\"Repository\"}],\n  relations: [{source:\"opencode-speak\", type:\"DEPENDS_ON\", target:\"OpenCode\"}],\n  supersedes: \"00-Personal/OpenCode/202611011203-opencode-tts-plugin-server-side-speak-on-idle-tui-only-toggl.md\",\n  reason: \"Server event names verified as session.execution.started/succeeded; a session.idle-only hook misses turns.\",\n});\nreturn JSON.stringify(a).slice(0,900);"} 
