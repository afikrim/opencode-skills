[0m⚙ [0mexecute {"code":"const a = await tools.second_brain.create_note({\n  segment: \"personal\",\n  area: \"OpenCode\",\n  title: \"`ctx.experimental.generate.text` hangs in a one-shot `run` mode — completion work must run detached\",\n  body: \"In an OpenCode V2 plugin, calling `ctx.experimental.generate.text` from a one-shot `opencode run` session hangs: the server shuts down mid-call and the promise never resolves (symptom: normalization appears to freeze).\\nWorkaround that works: run the LLM normalization/speak pipeline detached from the request lifecycle instead of awaiting it inline.\\nScope: fine for real TUI use, where the server stays alive; `run`-mode speech is not a goal of the plugin.\\nWhen debugging a plugin that \\\"hangs\\\", check whether it is awaiting server `ctx` work from a short-lived session before suspecting the prompt or model.\",\n  tags: \"opencode, plugin, generate-text, tts, bugfix\",\n  memory_type: \"procedure\",\n  entities: [{name:\"OpenCode\", type:\"System\"}, {name:\"opencode-speak\", type:\"Repository\"}, {name:\"DeepSeek V4.1 Flash\", type:\"Technology\"}],\n  relations: [{source:\"opencode-speak\", type:\"DEPENDS_ON\", target:\"OpenCode\"}],\n});\nreturn JSON.stringify(a).slice(0,800);"} 
