[0m⚙ [0mexecute {"code":"const a = await tools.second_brain.create_note({\n  segment:\"work\",\n  project:\"inline-design\",\n  title:\"Inline Design job raster metadata from gdalinfo -json drives both map bounds and DXF placement\",\n  body:`In the per-file (?job=) flow, raster metadata is parsed from \\`gdalinfo -json\\` into the extraction job record and is the single source of truth for the viewer.\nIt supplies the map bounds, CRS and geotransform; the DXF overlays are then mapped through the same numbers client-side.\nDXF parsing stays entirely in the browser (vendored parser) — the backend stores/validates/serves DXF files and has no geometry logic.\nConsequence: server-side conversion and client-side placement cannot drift, because neither re-derives bounds on its own.\nVerified against real file numbers in a unit test over the parser output.`,\n  metadata:{memory_type:\"decision\", tags:[\"inline-design\",\"gdalinfo\",\"tiles\",\"dxf\",\"map\",\"architecture\"],\n    entities:[{name:\"inline-design\",type:\"Project\"},{name:\"GDAL\",type:\"Technology\"},{name:\"DXF\",type:\"Technology\"},{name:\"Leaflet\",type:\"Technology\"}],\n    relations:[{source:\"inline-design\",type:\"USES\",target:\"GDAL\",quote:\"raster metadata is parsed from gdalinfo -json into the extraction job record\"},\n               {source:\"DXF\",type:\"REQUIRES\",target:\"GDAL\",quote:\"geotransform from gdalinfo drives DXF placement\"}]}\n});\nreturn a;"} 
