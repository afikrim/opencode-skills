[0m⚙ [0mexecute {"code":"const portNote = \"01-Work/inline-design/202610290801-inline-design-on-asus-uses-an-app-port-knob-because-8080-808.md\";\nconst embedNote = \"01-Work/inline-design/202610290804-go-embed-rejects-paths-so-inline-design-viewer-assets-use-a-.md\";\nconst cliNote = \"01-Work/inline-design/202610290804-inline-design-api-image-needs-docker-cli-or-the-worker-silen.md\";\n\nconst mig = await tools.second_brain.create_note({\n  segment: \"work\",\n  project: \"inline-design\",\n  title: \"inline-design migrator must apply every migrations/*.sql in order, not just the first\",\n  body: [\n    \"First asus deploy came up with only `001_init` applied: `tiles_status` and the raster columns never existed, so uploads failed.\",\n    \"Cause: the migrator ran a single hardcoded migration (or first file) instead of the whole directory.\",\n    \"Fix (commit `b02df42`): apply every `*.sql` in `migrations/` in filename order, resolved from either the local dir or the container copy.\",\n    \"Verify after deploy with `\\\\d` — all 7 expected columns must be present, not just the base tables.\",\n    \"Lesson: after any containerized migration change, inspect the actual schema rather than trusting `-migrate-up` exit 0.\",\n  ].join(\"\\n\"),\n  tags: \"inline-design,deployment,migrations,postgres,asus\",\n  memory_type: \"learning\",\n  links: [portNote, cliNote].join(\",\"),\n  entities: [\n    { type: \"Project\", name: \"inline-design\" },\n    { type: \"Technology\", name: \"PostgreSQL\" },\n    { type: \"Place\", name: \"asus home server\" },\n  ],\n  relations: [\n    { source: \"inline-design\", type: \"STORES\", target: \"PostgreSQL\", quote: \"migrator only ever applied 001 — so tiles_status and the raster columns didn't exist\" },\n  ],\n});\n\nconst live = await tools.second_brain.create_note({\n  segment: \"work\",\n  project: \"inline-design\",\n  title: \"inline-design stack is live on asus at http://100.80.171.33:8082 behind Basic auth\",\n  body: [\n    \"Go API + Postgres 16 via `docker compose up --build` with `-migrate-up`; both migrations applied, all 7 new columns verified.\",\n    \"Runner log reads `docker runner ready` (real docker runner, not the fake fallback).\",\n    \"Verified from the dev machine over the Tailnet: 401 without creds, 200 with creds, upload `201`, library listing with Postgres timestamps, viewer page 200.\",\n    \"Basic-auth user is `aziz`; the password is generated on the box and stored only in `~/inline-design/.env` on asus.\",\n    \"Host is x86_64, so GDAL/ECW tiling runs natively — minutes instead of ~12 min under emulation locally.\",\n  ].join(\"\\n\"),\n  tags: \"inline-design,deployment,asus,tailscale,docker\",\n  memory_type: \"fact\",\n  links: [portNote, mig ? \"\" : \"\"].filter(Boolean).join(\",\") || portNote,\n  entities: [\n    { type: \"Project\", name: \"inline-design\" },\n    { type: \"Place\", name: \"asus home server\" },\n    { type: \"Technology\", name: \"Tailscale\" },\n    { type: \"Technology\", name: \"PostgreSQL\" },\n  ],\n  relations: [\n    { source: \"inline-design\", type: \"RUNS_ON\", target: \"asus home server\", quote: \"Service is fully live on asus with Postgres\" },\n    { source: \"inline-design\", type: \"INTEGRATES_WITH\", target: \"Tailscale\", quote: \"verify from here over the Tailnet\" },\n  ],\n});\n\nconst xfer = await tools.second_brain.create_note({\n  segment: \"work\",\n  project: \"inline-design\",\n  title: \"Large ECW transfers to asus die near the end over plain ssh; resume with rsync and checksum\",\n  body: [\n    \"The 1.8 GB ECW copy to asus over `ssh asus` dropped at ~90% (1.63 of 1.83 GB) — scp/ssh pipes are not resumable.\",\n    \"Resume with `rsync --partial --progress` (or `--append-verify`) from the local source rather than restarting.\",\n    \"Checksum the landed file against the local copy (`sha256sum`) before running the pipeline — a truncated ECW fails deep inside GDAL, not at transfer.\",\n  ].join(\"\\n\"),\n  tags: \"inline-design,asus,rsync,transfer,ecw\",\n  memory_type: \"procedure\",\n  links: live && typeof live === \"object\" ? \"\" : \"\",\n  entities: [\n    { type: \"Project\", name: \"inline-design\" },\n    { type: \"Place\", name: \"asus home server\" },\n    { type: \"Technology\", name: \"rsync\" },\n  ],\n  relations: [],\n});\n\nconsole.log(JSON.stringify(mig).slice(0,600));\nconsole.log(JSON.stringify(live).slice(0,600));\nconsole.log(JSON.stringify(xfer).slice(0,600));"} 
